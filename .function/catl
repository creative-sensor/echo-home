LEVEL_RX = re.compile(r"\b(FATAL|CRITICAL|CRIT|ERROR|ERR|WARNING|WARN|NOTICE|INFO|DEBUG|TRACE)\b")
SEVERE = {"FATAL", "CRITICAL", "CRIT", "ERROR", "ERR", "WARNING", "WARN"}
MASKS = [
    (TS_ANY, "<TS>"),
    (re.compile(r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b"), "<UUID>"),
    (re.compile(r"\b\d{1,3}(?:\.\d{1,3}){3}(?::\d+)?\b"), "<IP>"),
    (re.compile(r"\b0x[0-9a-fA-F]+\b|\b[0-9a-fA-F]{12,}\b"), "<HEX>"),
    (re.compile(r'"[^"\n]{0,200}"'), "<STR>"),
    (re.compile(r"(?<![A-Za-z<])[-+]?\d+(?:\.\d+)?(?:ms|s|kb|mb|gb|%)?\b"), "<NUM>"),
]


def mask_line(l: str) -> str:
    for rx, rep in MASKS:
        l = rx.sub(rep, l)
    return clip(l, 200)


def mine_templates(lines, tools):
    keyfn, miner = mask_line, None
    try:
        import logging
        from drain3 import TemplateMiner
        logging.getLogger("drain3").setLevel(logging.ERROR)
        miner = TemplateMiner()
    except Exception:
        miner = None
    recs = {}
    for i, l in enumerate(lines, 1):
        if not l.strip():
            continue
        if miner is not None:
            try:
                key = miner.add_log_message(TS_ANY.sub("", l, count=1).strip())["cluster_id"]
            except Exception:
                miner, recs = None, {}
                return mine_templates_fallback(lines, tools)
        else:
            key = keyfn(l)
        rec = recs.get(key)
        if rec is None:
            if len(recs) >= MAX_TEMPLATES:
                key = "<other templates>"
                rec = recs.get(key)
            if rec is None:
                rec = recs[key] = {"key": key, "n": 0, "first": i, "last": i, "lines": [], "levels": Counter()}
        rec["n"] += 1
        rec["last"] = i
        if len(rec["lines"]) < 200:
            rec["lines"].append(i)
        lv = LEVEL_RX.search(l[:120])
        if lv:
            rec["levels"][lv.group(1)] += 1
    if miner is not None:
        by_id = {c.cluster_id: c.get_template() for c in miner.drain.clusters}
        for rec in recs.values():
            rec["t"] = by_id.get(rec["key"], str(rec["key"]))
        tools.append("drain3")
    else:
        for rec in recs.values():
            rec["t"] = rec["key"]
        tools.append("mask-templates")
    return recs


def mine_templates_fallback(lines, tools):
    recs = {}
    for i, l in enumerate(lines, 1):
        if not l.strip():
            continue
        key = mask_line(l)
        rec = recs.setdefault(key, {"key": key, "t": key, "n": 0, "first": i, "last": i,
                                    "lines": [], "levels": Counter()})
        rec["n"] += 1
        rec["last"] = i
        if len(rec["lines"]) < 200:
            rec["lines"].append(i)
        lv = LEVEL_RX.search(l[:120])
        if lv:
            rec["levels"][lv.group(1)] += 1
    tools.append("mask-templates")
    return recs


def build_log(data, name, tools):
    text = decode(data)
    lines = split_lines(text)
    recs = mine_templates(lines, tools)
    ordered = sorted(recs.values(), key=lambda r: (-r["n"], r["first"]))
    templates, levels = [], Counter()
    for k, r in enumerate(ordered, 1):
        levels.update(r["levels"])
        templates.append({"id": f"L{k}", "t": clip(str(r["t"]), 180), "n": r["n"], "first": r["first"],
                          "last": r["last"], "lines": r["lines"],
                          "level": r["levels"].most_common(1)[0][0] if r["levels"] else ""})
    first_ts = last_ts = None
    for l in lines[:5000]:
        mt = TS_ANY.search(l[:80])
        if mt:
            first_ts = mt.group(0)
            break
    for l in reversed(lines[-5000:]):
        mt = TS_ANY.search(l[:80])
        if mt:
            last_ts = mt.group(0)
            break
    notes = [f"{len(templates):,} distinct message templates"]
    if first_ts:
        notes.append(f"time range: {first_ts} -> {last_ts}")
    if levels:
        tot = sum(levels.values())
        notes.append("levels: " + ", ".join(f"{k} {100 * v / tot:.1f}%" if v >= tot / 1000 else f"{k} x{v}"
                                            for k, v in levels.most_common(6)))
    return text, {"notes": notes, "nodes": [], "templates": templates[:1000]}


