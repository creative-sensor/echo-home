# ---------------------------------------------------------------- utilities

def die(msg: str, code: int = 1):
    print(f"catl: {msg}", file=sys.stderr)
    sys.exit(code)


def est_tokens(s: str) -> float:
    """Fast token estimate: ~4 chars/token for ASCII, ~1.5 for other scripts."""
    a = len(s.encode("ascii", "ignore"))
    return a / 4.0 + (len(s) - a) / 1.5


def fmt_tok(n) -> str:
    n = int(round(n))
    if n >= 1_000_000:
        return f"{n / 1e6:.1f}M"
    return f"{n / 1e3:.1f}K" if n >= 1000 else str(n)


def fmt_bytes(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n}B" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return str(n)


def clip(s: str, n: int) -> str:
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1] + "\u2026"


def compact_ids(prefix: str, idxs, limit: int = 6) -> str:
    runs = []
    for i in sorted(set(idxs)):
        if runs and i == runs[-1][1] + 1:
            runs[-1][1] = i
        else:
            runs.append([i, i])
    parts = [f"{prefix}{a}" if a == b else f"{prefix}{a}-{prefix}{b}" for a, b in runs]
    extra = len(parts) - limit
    return ",".join(parts[:limit]) + (f" +{extra} more" if extra > 0 else "")


def decode(data: bytes) -> str:
    try:
        text = data.decode("utf-8-sig")
    except UnicodeDecodeError:
        text = data.decode("cp1252", errors="replace")
    return text.replace("\r\n", "\n").replace("\r", "\n")


def split_lines(text: str) -> list[str]:
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def q(s) -> str:
    return shlex.quote(str(s))


def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def cache_dir(sha: str) -> str:
    """$MEMBASE_DIR/<1st hex>/<2nd hex>/<3rd+4th hex>/<full sha256>"""
    return os.path.join(MEMBASE_DIR, sha[0], sha[1], sha[2:4], sha)


def find_cached(prefix: str) -> list[str]:
    """Cache directories whose sha256 starts with prefix (at least 2 hex digits)."""
    level2 = os.path.join(MEMBASE_DIR, prefix[0], prefix[1])
    if len(prefix) >= 4:
        buckets = [os.path.join(level2, prefix[2:4])]
    else:
        buckets = [os.path.join(level2, b) for b in (sorted(os.listdir(level2)) if os.path.isdir(level2) else [])
                   if len(b) == 2 and b.startswith(prefix[2:])]
    found = []
    for bucket in buckets:
        if os.path.isdir(bucket):
            found += [os.path.join(bucket, d) for d in sorted(os.listdir(bucket))
                      if d.startswith(prefix) and not d.startswith(".")]
    return found


def write_json_atomic(path: str, obj):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, separators=(",", ":"))
    os.replace(tmp, path)


