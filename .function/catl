BRACE_FAMILIES = {"js", "go", "rust", "jvm", "c", "php", "bash"}
NOT_NAMES = {"if", "for", "while", "switch", "catch", "return", "else", "elif", "sizeof",
             "do", "try", "with", "new", "until", "unless", "foreach", "using", "lock"}


def brace_end(lines, i0):
    depth, opened = 0, False
    for i in range(i0, len(lines)):
        s = re.sub(r'"(?:\\.|[^"\\])*"|//.*$', "", lines[i])
        for ch in s:
            if ch == "{":
                depth += 1
                opened = True
            elif ch == "}":
                depth -= 1
            if opened and depth <= 0:
                return i + 1
        if not opened and (i - i0 >= 3 or s.rstrip().endswith(";")):
            return None
    return len(lines) if opened else None


def indent_end(lines, i0, ind, family):
    for i in range(i0 + 1, len(lines)):
        l = lines[i]
        if not l.strip():
            continue
        li = len(l) - len(l.lstrip())
        if li <= ind:
            if family in ("ruby", "lua") and re.match(r"\s*end\b", l):
                return i + 1
            if not re.match(r"\s*[}\])]", l):
                end = i
                while end > i0 + 1 and not lines[end - 1].strip():
                    end -= 1
                return end
    return len(lines)


def regex_symbols(lines, lang):
    family = REGEX_FAMILY.get(lang, "py")
    pats = [re.compile(p) for p in REGEX_SYMBOLS[family]]
    items = []
    for i, l in enumerate(lines):
        if len(l) > 300 or l.strip().startswith(("new ", "return ", "else", "throw ", "//", "#", "*")):
            continue
        for p in pats:
            mt = p.match(l)
            if not mt:
                continue
            name = mt.group(1)
            if name in NOT_NAMES:
                break
            end = brace_end(lines, i) if family in BRACE_FAMILIES else None
            if end is None:
                end = indent_end(lines, i, len(l) - len(l.lstrip()), family)
            items.append({"start": i + 1, "end": max(end, i + 1), "title": clip(l.strip(), 110), "name": name})
            break
    return items


def py_symbols(text):
    tree = ast.parse(text)
    items, imports = [], []

    def visit(body, prefix, depth):
        for n in body:
            if depth == 0 and isinstance(n, ast.Import):
                imports.extend(a.name for a in n.names)
            elif depth == 0 and isinstance(n, ast.ImportFrom):
                imports.append(n.module or ".")
            if not isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                continue
            start = min([n.lineno] + [d.lineno for d in n.decorator_list])
            if isinstance(n, ast.ClassDef):
                bases = ", ".join(ast.unparse(b) for b in n.bases)
                sig = f"class {n.name}({bases})" if bases else f"class {n.name}"
            else:
                sig = f"{'async ' if isinstance(n, ast.AsyncFunctionDef) else ''}def {n.name}({ast.unparse(n.args)})"
                if n.returns is not None:
                    sig += f" -> {ast.unparse(n.returns)}"
            doc = (ast.get_docstring(n) or "").strip().split("\n")[0]
            items.append({"start": start, "end": n.end_lineno, "title": clip(sig, 110),
                          "name": prefix + n.name, "doc": clip(doc, 80)})
            if depth < 3:
                visit(n.body, prefix + n.name + ".", depth + 1)

    visit(tree.body, "", 0)
    return items, imports, (ast.get_docstring(tree) or "").strip()


TS_DEF = re.compile(r"(function|method|class|struct|interface|trait|impl|enum|module|namespace|type)_(definition|declaration|item|specifier|spec)$")
TS_NAMES = {"csharp": ["csharp", "c_sharp"], "bash": ["bash"], "tsx": ["tsx"]}


def ts_symbols(text, lang):
    from tree_sitter_language_pack import get_parser
    parser = None
    for cand in TS_NAMES.get(lang, [lang]):
        try:
            parser = get_parser(cand)
            break
        except Exception:
            continue
    if parser is None:
        raise RuntimeError("no tree-sitter grammar")
    src = text.encode("utf-8")
    tree = parser.parse(src)
    items = []

    def name_of(node):
        n = node.child_by_field_name("name")
        if n is None:
            queue = [c for c in (node.child_by_field_name("declarator"), node.child_by_field_name("type")) if c]
            seen = 0
            while queue and seen < 30:
                cur = queue.pop(0)
                seen += 1
                if cur.type in ("identifier", "field_identifier", "type_identifier", "qualified_identifier"):
                    n = cur
                    break
                queue.extend(cur.children)
        return src[n.start_byte:n.end_byte].decode("utf-8", "replace") if n is not None else None

    def walk(node, prefix, depth, hops):
        for ch in node.children:
            if TS_DEF.search(ch.type):
                nm = name_of(ch)
                if nm:
                    first = src[ch.start_byte:ch.end_byte].split(b"\n", 1)[0].decode("utf-8", "replace")
                    items.append({"start": ch.start_point[0] + 1, "end": ch.end_point[0] + 1,
                                  "title": clip(first.strip(), 110), "name": prefix + nm})
                    if depth < 3:
                        walk(ch, prefix + nm + ".", depth + 1, 0)
                    continue
            if hops < 4 and ch.child_count:
                walk(ch, prefix, depth, hops + 1)

    walk(tree.root_node, "", 0, 0)
    return items


def build_code(data, name, tools):
    text = decode(data)
    lines = split_lines(text)
    ext = os.path.splitext(name)[1].lower()
    lang = CODE_LANG.get(ext, "python")
    m = {"notes": [], "lang": lang}
    items, imports, sure, moddoc = None, [], True, ""
    if lang == "python":
        try:
            items, imports, moddoc = py_symbols(text)
            tools.append("ast")
        except (SyntaxError, ValueError):
            items = None
    if items is None:
        try:
            items = ts_symbols(text, lang)
            tools.append("tree-sitter")
        except Exception:
            items = None
    if items is None:
        items = regex_symbols(lines, lang)
        sure = False
        tools.append("regex")
    if not imports:
        for l in lines[:400]:
            im = re.match(r"\s*(?:import|from|#include|use|require|using)\s+[\"'<]?([\w./:@-]+)", l)
            if im:
                imports.append(im.group(1))
    if imports:
        uniq = list(dict.fromkeys(imports))
        m["notes"].append("imports: " + ", ".join(uniq[:15]) + (f" (+{len(uniq) - 15})" if len(uniq) > 15 else ""))
    if moddoc:
        m["opening"] = clip(moddoc.split("\n\n")[0], 220)
    nodes = nest(items, sure=sure)
    by_id = {nd["id"]: nd for nd in nodes}
    for nd in nodes:
        if "." not in nd["name"] and nd["parent"]:
            nd["name"] = by_id[nd["parent"]]["name"] + "." + nd["name"]
    idc = Counter(IDENT_RX.findall(text))
    for nd in nodes:
        nd["refs"] = max(0, idc[nd["name"].split(".")[-1]] - 1)
    m["nodes"] = nodes
    m["edges"] = code_edges(nodes, lines)
    return text, m


def code_edges(nodes, lines):
    by_short = defaultdict(list)
    for nd in nodes:
        short = nd["name"].split(".")[-1]
        if len(short) >= 3 and not short.startswith("__"):
            by_short[short].append(nd["id"])
    targets = {k: v for k, v in by_short.items() if len(v) <= 3}
    parents = {nd["parent"] for nd in nodes if nd["parent"]}
    edges = {}
    for nd in nodes:
        if nd["id"] in parents:
            continue
        idents = set(IDENT_RX.findall("\n".join(lines[nd["start"]:nd["end"]])))
        out = []
        for w in idents & targets.keys():
            for t in targets[w]:
                if t != nd["id"] and not t.startswith(nd["id"] + ".") and not nd["id"].startswith(t + "."):
                    out.append(t)
        if out:
            edges[nd["id"]] = sorted(set(out))[:30]
    return edges


# ------------------------------------------------------------ json / jsonl / table

def jtype(v):
    if isinstance(v, bool):
        return "bool"
    if v is None:
        return "null"
    return {dict: "object", list: "array", str: "str", int: "int", float: "float"}.get(type(v), "?")


def array_desc(arr, limit=200):
    sample = arr[:limit]
    types = Counter(jtype(x) for x in sample)
    if types.get("object", 0) >= 0.8 * len(sample):
        objs = [x for x in sample if isinstance(x, dict)]
        keys, ktypes = Counter(), defaultdict(Counter)
        for o in objs:
            for k, v in o.items():
                keys[k] += 1
                ktypes[k][jtype(v)] += 1
        parts = []
        for k, c in keys.most_common(12):
            t = "|".join(t for t, _ in ktypes[k].most_common(2))
            pct = "" if c == len(objs) else f" {100 * c // len(objs)}%"
            parts.append(f"{k}:{t}{pct}")
        more = f", +{len(keys) - 12} keys" if len(keys) > 12 else ""
        return f"array[{len(arr)}] of object {{{', '.join(parts)}{more}}}"
    return f"array[{len(arr)}] of " + "|".join(t for t, _ in types.most_common(3))


def build_json(data, name, tools):
    sys.setrecursionlimit(20000)
    obj = json.loads(decode(data))
    out, items = [], []
    ident = re.compile(r"^[A-Za-z_]\w*$")

    def emit(v, path, indent, prefix, trailing, depth, record):
        pad = "  " * indent
        start = len(out) + 1
        if isinstance(v, dict) and v:
            out.append(pad + prefix + "{")
            kv = list(v.items())
            for j, (k, x) in enumerate(kv):
                sub = f"{path}.{k}" if ident.match(k) else f"{path}[{json.dumps(k, ensure_ascii=False)}]"
                emit(x, sub, indent + 1, json.dumps(k, ensure_ascii=False) + ": ",
                     "," if j < len(kv) - 1 else "", depth + 1, record)
            out.append(pad + "}" + trailing)
            desc = f"object {{{len(v)} keys: {', '.join(list(v)[:8])}{', ...' if len(v) > 8 else ''}}}"
        elif isinstance(v, list) and v:
            out.append(pad + prefix + "[")
            for j, x in enumerate(v):
                emit(x, f"{path}[{j}]", indent + 1, "", "," if j < len(v) - 1 else "", depth + 1, record and j < 2)
            out.append(pad + "]" + trailing)
            desc = array_desc(v)
        else:
            out.append(pad + prefix + json.dumps(v, ensure_ascii=False) + trailing)
            return
        if record and depth <= 3 and len(items) < 2000:
            items.append({"start": start, "end": len(out), "title": f"{path}  {desc}", "name": path})

    emit(obj, "$", 0, "", "", 0, True)
    m = {"notes": ["lines refer to the pretty-printed JSON stored in the cache"]}
    m["nodes"] = nest(items, sure=True)
    return "\n".join(out) + "\n", m


def build_jsonl(data, name, tools):
    text = decode(data)
    lines = split_lines(text)
    recs, bad = [], 0
    for l in lines[:2000]:
        if not l.strip():
            continue
        try:
            recs.append(json.loads(l))
        except ValueError:
            bad += 1
    m = {"notes": [f"{sum(1 for l in lines if l.strip()):,} records (one JSON value per line)"], "nodes": []}
    if recs:
        m["notes"].append("schema (first 2000 records): " + array_desc(recs))
    if bad:
        m["notes"].append(f"{bad} unparseable lines in the first 2000")
    return text, m


def build_table(data, name, tools):
    text = decode(data)
    ext = os.path.splitext(name)[1].lower()
    try:
        delim = "\t" if ext == ".tsv" else csv.Sniffer().sniff(text[:65536], delimiters=",;\t|").delimiter
    except csv.Error:
        delim = ","
    reader = csv.reader(io.StringIO(text), delimiter=delim)
    header = next(reader, [])
    ncol = len(header)
    stats = [{"nonnull": 0, "num": 0, "int": 0, "min": None, "max": None, "distinct": set(),
              "top": Counter(), "over": False, "date": 0} for _ in header]
    rows = 0
    for row in reader:
        rows += 1
        if rows > 200_000:
            continue
        for j in range(min(ncol, len(row))):
            v = row[j].strip()
            if not v or v.lower() in ("null", "na", "n/a", "none", "nan"):
                continue
            st = stats[j]
            st["nonnull"] += 1
            try:
                x = float(v.replace(",", "")) if delim != "," else float(v)
                st["num"] += 1
                st["int"] += re.fullmatch(r"-?\d+", v) is not None
                st["min"] = x if st["min"] is None else min(st["min"], x)
                st["max"] = x if st["max"] is None else max(st["max"], x)
            except ValueError:
                st["date"] += re.match(r"\d{4}-\d{2}-\d{2}", v) is not None
            if not st["over"]:
                st["distinct"].add(v)
                st["top"][v] += 1
                if len(st["distinct"]) > 1000:
                    st["over"], st["top"] = True, Counter()
    sampled = min(rows, 200_000)
    cols = []
    for h, st in zip(header, stats):
        nn = st["nonnull"] or 1
        if st["num"] == st["nonnull"] and st["nonnull"]:
            typ = "int" if st["int"] == st["num"] else "float"
        elif st["date"] >= 0.9 * nn:
            typ = "date"
        else:
            typ = "str"
        col = {"name": h, "type": typ, "fill": round(100 * st["nonnull"] / max(1, sampled)),
               "distinct": "1000+" if st["over"] else len(st["distinct"])}
        if typ in ("int", "float") and st["min"] is not None:
            col["range"] = [st["min"], st["max"]]
        if not st["over"] and st["top"] and len(st["distinct"]) <= 50:
            col["top"] = [[v, round(100 * c / nn)] for v, c in st["top"].most_common(3)]
        cols.append(col)
    m = {"notes": [f"{ncol} columns x {rows:,} rows, delimiter {delim!r}" +
                   (" (stats from first 200,000 rows)" if rows > 200_000 else "")],
         "nodes": [], "columns": cols}
    return text, m


