def detect_kind(name: str, data: bytes) -> str:
    ext = os.path.splitext(name)[1].lower()
    head = data[:8192]
    if head.startswith(b"%PDF") or ext == ".pdf":
        return "pdf"
    if b"\x00" in head:
        return "binary"
    if ext in (".md", ".markdown", ".mdx"):
        return "markdown"
    if ext in (".html", ".htm", ".xhtml"):
        return "html"
    if ext == ".json":
        return "json"
    if ext in (".jsonl", ".ndjson"):
        return "jsonl"
    if ext in (".csv", ".tsv"):
        return "table"
    if ext in CODE_LANG:
        return "code"
    if ext == ".log":
        return "log"
    txt = head.decode("utf-8", "replace").lstrip()
    if txt[:1] in "{[":
        try:
            json.loads(decode(data))
            return "json"
        except ValueError:
            first = [l for l in txt.splitlines()[:5] if l.strip()]
            try:
                if len(first) >= 2 and all(isinstance(json.loads(l), (dict, list)) for l in first[:-1]):
                    return "jsonl"
            except ValueError:
                pass
    if re.match(r"(?is)<!doctype html|<html", txt):
        return "html"
    sample = txt.splitlines()[:200]
    nonblank = [l for l in sample if l.strip()]
    if len(nonblank) >= 10 and sum(bool(TS_ANY.search(l[:60])) for l in nonblank) >= 0.6 * len(nonblank):
        return "log"
    if sum(bool(re.match(r"#{1,6}\s+\S", l)) for l in sample) >= 3:
        return "markdown"
    if txt.startswith("#!") and re.search(r"python", txt.split("\n", 1)[0]):
        return "code"
    return "text"


# ------------------------------------------------------------ outline helpers

def heading_spans(heads, nlines: int) -> list[dict]:
    """heads: sorted (line0, level, title). Returns items with 1-based start/end."""
    items, open_ = [], []
    for i, lvl, title in heads:
        while open_ and open_[-1]["lvl"] >= lvl:
            open_.pop()["end"] = i
        it = {"start": i + 1, "end": nlines, "lvl": lvl, "title": title}
        open_.append(it)
        items.append(it)
    for it in items:
        it["end"] = max(it["end"], it["start"])
    return items


def nest(items: list[dict], sure: bool) -> list[dict]:
    """Assign hierarchical ids (S1, S1.2, ...) by span containment."""
    items = sorted(items, key=lambda x: (x["start"], -x["end"]))
    stack, out, top = [], [], 0
    for it in items:
        while stack and not (it["end"] <= stack[-1]["end"]):
            stack.pop()
        if stack:
            p = stack[-1]
            p["_k"] += 1
            nid, depth, pid = f"{p['id']}.{p['_k']}", p["depth"] + 1, p["id"]
        else:
            top += 1
            nid, depth, pid = f"S{top}", 1, None
        node = {k: v for k, v in it.items() if k != "lvl"}
        node.update(id=nid, depth=depth, parent=pid, sure=it.get("sure", sure), _k=0)
        stack.append(node)
        out.append(node)
    for nd in out:
        nd.pop("_k", None)
    return out


def add_preamble(heads, lines):
    if heads and heads[0][0] > 0 and any(l.strip() and not l.startswith("=== page ") for l in lines[: heads[0][0]]):
        return [(0, 99, "(before first heading)")] + list(heads)
    return list(heads)


def deepest(nodes: list[dict], line: int):
    best = None
    for nd in nodes:
        if nd["start"] > line:
            break
        if nd["end"] >= line and (best is None or nd["depth"] > best["depth"]):
            best = nd
    return best


# ------------------------------------------------------------ plain text

NUM_H = re.compile(r"^\s{0,3}((?:\d{1,2}\.)*\d{1,2})[.)]?\s+(\S.*)$")
WORD_H = re.compile(r"^\s{0,3}(chapter|part|section|appendix|book|ch\u01b0\u01a1ng|ph\u1ea7n|m\u1ee5c)\b", re.I)
ROMAN_H = re.compile(r"^\s{0,3}[IVXLC]{1,6}\.\s+\S")


def plain_headings(lines: list[str]):
    heads, n = [], len(lines)
    for i, l in enumerate(lines):
        s = l.strip()
        if not s or len(s) > 90 or s.startswith("=== page "):
            continue
        if i > 0 and lines[i - 1].strip() and not lines[i - 1].startswith("=== page "):
            continue
        next_blank = i + 1 >= n or not lines[i + 1].strip()
        words = len(s.split())
        level = None
        m = NUM_H.match(l)
        if m and words <= 14 and s[-1] not in ".,;" and m.group(2)[:1].isalpha():
            level = m.group(1).count(".") + 1
        elif WORD_H.match(s) and words <= 14 and s[-1] not in ".,;":
            level = 1
        elif ROMAN_H.match(l) and words <= 12 and s[-1] not in ".,;":
            level = 1
        elif (next_blank and words <= 10 and s.upper() == s
              and sum(c.isalpha() for c in s) >= 3 and s[-1] not in ".,;"):
            level = 1
        if level:
            heads.append((i, min(level, 4), s))
    return heads


def text_nodes(lines: list[str], m: dict):
    heads = plain_headings(lines)
    total = sum(est_tokens(l) for l in lines)
    if len(heads) > max(40, total / 150):
        heads = [h for h in heads if h[1] == 1]
        if len(heads) > max(40, total / 150):
            m["notes"].append("heading-like lines are too frequent to trust; no outline")
            heads = []
    nonblank = [len(l) for l in lines if l.strip()]
    if len(nonblank) > 50:
        med = statistics.median(nonblank)
        near = sum(abs(x - med) <= 10 for x in nonblank) / len(nonblank)
        if 50 <= med <= 100 and near >= 0.6:
            m["notes"].append("text is hard-wrapped: single newlines are not paragraph breaks")
    return nest(heading_spans(add_preamble(heads, lines), len(lines)), sure=False)


def build_text(data, name, tools):
    text = decode(data)
    lines = split_lines(text)
    m = {"notes": []}
    m["nodes"] = text_nodes(lines, m)
    return text, m


# ------------------------------------------------------------ markdown / html

def md_headings(lines: list[str]):
    heads, fence = [], None
    for i, l in enumerate(lines):
        s = l.lstrip()
        fm = re.match(r"(`{3,}|~{3,})", s)
        if fm:
            if fence is None:
                fence = fm.group(1)
            elif s.startswith(fence):
                fence = None
            continue
        if fence:
            continue
        hm = re.match(r"^ {0,3}(#{1,6})\s+(.*?)(?:\s+#+)?\s*$", l)
        if hm and hm.group(2):
            heads.append((i, len(hm.group(1)), hm.group(2).strip()))
        elif (i >= 1 and re.match(r"^ {0,3}(=+|-{3,})\s*$", l) and lines[i - 1].strip()
              and len(lines[i - 1].strip()) <= 100
              and not re.match(r"^\s*([-*+]|\d+\.)\s", lines[i - 1])
              and (i == 1 or not lines[i - 2].strip())):
            heads.append((i - 1, 1 if "=" in l else 2, lines[i - 1].strip()))
    return heads


def build_markdown(data, name, tools, text=None):
    text = decode(data) if text is None else text
    lines = split_lines(text)
    heads = md_headings(lines)
    m = {"notes": []}
    for _, lvl, title in heads:
        if lvl == 1:
            m["title"] = title
            break
    m["nodes"] = nest(heading_spans(add_preamble(heads, lines), len(lines)), sure=True)
    return text, m


class _HTMLToText(html.parser.HTMLParser):
    BLOCK = {"p", "div", "section", "article", "header", "footer", "main", "aside",
             "ul", "ol", "table", "tr", "blockquote", "br", "hr", "dt", "dd",
             "figure", "form", "nav", "pre"}
    SKIP = {"script", "style", "noscript", "svg", "template"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip, self.pre, self.in_title, self.title = [], 0, 0, False, ""

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        elif tag == "title":
            self.in_title = True
        elif re.fullmatch(r"h[1-6]", tag):
            self.out.append("\n\n" + "#" * int(tag[1]) + " ")
        elif tag == "li":
            self.out.append("\n- ")
        elif tag in ("td", "th"):
            self.out.append(" | ")
        elif tag in self.BLOCK:
            self.out.append("\n")
        if tag == "pre":
            self.pre += 1

    def handle_endtag(self, tag):
        if tag in self.SKIP:
            self.skip = max(0, self.skip - 1)
        elif tag == "title":
            self.in_title = False
        elif re.fullmatch(r"h[1-6]", tag):
            self.out.append("\n\n")
        elif tag in self.BLOCK:
            self.out.append("\n")
        if tag == "pre":
            self.pre = max(0, self.pre - 1)

    def handle_data(self, d):
        if self.in_title:
            self.title += d
            return
        if self.skip:
            return
        self.out.append(d if self.pre else re.sub(r"\s+", " ", d))


def build_html(data, name, tools):
    p = _HTMLToText()
    p.feed(decode(data))
    p.close()
    text = "".join(p.out)
    text = "\n".join(l.strip() for l in text.split("\n"))
    text = re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"
    text, m = build_markdown(b"", name, tools, text=text)
    if p.title.strip():
        m["title"] = clip(p.title, 120)
    m["notes"].append("HTML converted to text; headings kept as '#' lines")
    return text, m


# ------------------------------------------------------------ pdf

def build_pdf(data, name, tools):
    pages, toc, title = None, [], ""
    try:
        try:
            import pymupdf as fitz
        except ImportError:
            import fitz
        doc = fitz.open(stream=data, filetype="pdf")
        pages = [pg.get_text() for pg in doc]
        toc = doc.get_toc(simple=True)
        title = (doc.metadata or {}).get("title") or ""
        tools.append("pymupdf")
    except Exception:
        pages = None
    if pages is None and shutil.which("pdftotext"):
        with tempfile.NamedTemporaryFile(suffix=".pdf") as tmp:
            tmp.write(data)
            tmp.flush()
            r = subprocess.run(["pdftotext", "-layout", tmp.name, "-"], capture_output=True)
        if r.returncode == 0:
            pages = r.stdout.decode("utf-8", "replace").split("\f")
            if pages and not pages[-1].strip():
                pages.pop()
            tools.append("pdftotext")
    if pages is None:
        try:
            from pypdf import PdfReader
            pages = [pg.extract_text() or "" for pg in PdfReader(io.BytesIO(data)).pages]
            tools.append("pypdf")
        except Exception:
            pages = None
    if pages is None:
        raise RuntimeError("no PDF text extractor found: pip install pymupdf (or install poppler-utils)")
    lines, page_line = [], {}
    for k, ptext in enumerate(pages, 1):
        page_line[k] = len(lines)
        lines.append(f"=== page {k} ===")
        lines.extend(split_lines(ptext.replace("\r\n", "\n")))
    text = "\n".join(lines) + "\n"
    m = {"notes": [f"{len(pages)} pages; page markers are lines '=== page N ==='"]}
    if title.strip():
        m["title"] = clip(title, 120)
    if sum(len(p.strip()) for p in pages) < 100 * max(1, len(pages)):
        m["notes"].append("very little extractable text: likely scanned, OCR needed")
    heads = []
    if toc:
        for lvl, t, pg in toc:
            if pg not in page_line:
                continue
            at, end = page_line[pg], page_line.get(pg + 1, len(lines))
            key = " ".join(t.split()).casefold()[:40]
            for j in range(at, end):
                if key and key in " ".join(lines[j].split()).casefold():
                    at = j
                    break
            heads.append((at, lvl, t.strip()))
        heads.sort(key=lambda h: h[0])
        m["nodes"] = nest(heading_spans(add_preamble(heads, lines), len(lines)), sure=True)
    else:
        m["nodes"] = text_nodes(lines, m)
    return text, m


