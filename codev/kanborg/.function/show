#!/usr/bin/env bash

withtitle=0
withcolor=0
for arg in "$@"; do
    [ "$arg" = "--title" ] && withtitle=1
    { [ "$arg" = "-c" ] || [ "$arg" = "--color" ]; } && withcolor=1
done

find datum/$(date +%Y) | awk -F/ -v withtitle="$withtitle" -v withcolor="$withcolor" '
BEGIN {
    cc["BACKLOG"] = "\033[31m"
    cc["TODO"]    = "\033[33m"
    cc["HOLD"]    = "\033[35m"
    cc["WIP"]     = "\033[36m"
    cc["DONE"]    = "\033[32m"
    reset = "\033[0m"
}
/\/(BACKLOG|TODO|HOLD|WIP|DONE)\// {
    status = $3
    file   = $4

    cell = file
    t = ""
    if (withtitle) {
        title = ""
        lines = 0
        while ((getline line < $0) > 0 && lines < 20) {
            lines++
            if (line ~ /^# +/) {
                sub(/^# +/, "", line)
                title = line
                break
            }
        }
        close($0)
        if (title != "") {
            t = title
            cell = file " `" t "`"
        }
    }

    row = ++count[status]
    data[status, row] = cell
    tt[status, row] = t
    if (row > maxrows) maxrows = row
}

END {
    cols[1] = "BACKLOG"
    cols[2] = "TODO"
    cols[3] = "HOLD"
    cols[4] = "WIP"
    cols[5] = "DONE"

    # Determine column widths
    for (c = 1; c <= 5; c++) {
        w[c] = length(cols[c])
        for (r = 1; r <= count[cols[c]]; r++) {
            clean = data[cols[c], r]
            gsub(/\x1b\[[0-9;]*m/, "", clean)
            l = length(clean)
            if (l > w[c]) w[c] = l
        }
    }

    # Header
    printf "|"
    for (c = 1; c <= 5; c++)
        printf " %-" w[c] "s |", cols[c]
    print ""

    # Markdown separator
    printf "|"
    for (c = 1; c <= 5; c++) {
        for (i = 0; i < w[c] + 2; i++) printf "-"
        printf "|"
    }
    print ""

    # Rows
    for (r = 1; r <= maxrows; r++) {
        printf "|"
        for (c = 1; c <= 5; c++) {
            cell = data[cols[c], r]
            if (withcolor && tt[cols[c], r] != "") {
                p = index(cell, "`")
                lead = substr(cell, 1, p)
                L = length(cell)
                pad = w[c] - L
                colored = lead cc[cols[c]] tt[cols[c], r] reset "`"
                padstr = sprintf("%*s", pad, "")
                printf " %s%s |", colored, padstr
            } else {
                printf " %-*s |", w[c], cell
            }
        }
        print ""
    }
}'
