#!/usr/bin/env python
"""
entry-search: rank Uvian cells against a free-text prompt.

Usage
  entry-search "how do I test the network speed"
  entry-search check network speed -n 5
  echo "kanban git workflow" | entry-search

Output (same layout as summer.yaml: one `uuid: {json}` line per hit, best first)
  0ba6ec37-...: {"score": 7.412, "path": "$UVIAN_DIR/0/b/a6/0ba6ec37-...", "<model>.gguf": "<summary>", ...}

  - "score" and "path" are added; every other key is copied from summer.yaml.
  - Entries without any summary get a "hint" (first meaningful line of the cell).
  - Encrypted entries keep only {"encrypted": "<recipient>"}; their content and summaries
    are never indexed, so they can only be found by uuid.

Ranking: BM25 over two fields (summer.yaml summaries weighted x2, cell content x1),
scaled by query-term coverage, plus bonuses for an exact phrase hit and for a uuid
(or uuid prefix of >= 6 hex chars) written in the prompt. Standard library only.

UVIAN_DIR (or --dir) selects the store; default is the parent of this .function folder.
"""
import argparse
import json
import math
import os
import re
import sys
from collections import Counter
from typing import Dict, List, Optional, Tuple

STOPWORDS = {
    "a", "an", "the", "and", "or", "for", "with", "that", "this", "from", "into", "what", "how",
    "can", "you", "are", "was", "were", "has", "have", "had", "not", "but", "all", "any", "our",
    "your", "please", "show", "tell", "give", "make", "let", "get", "use", "using", "want", "need",
    "about", "there", "then", "than", "them", "they", "which", "when", "where", "who", "why", "is",
    "it", "its", "of", "on", "in", "to", "be", "by", "as", "at", "do", "does", "me", "my", "i",
    "we", "us", "so", "if", "file", "content", "contains", "script", "this", "these", "those",
}
SUMMARY_WEIGHT, CONTENT_WEIGHT = 2.0, 1.0
K1, B = 1.2, 0.75
MAX_CONTENT_BYTES = 64 * 1024
UUID_HEX = re.compile(r"^[0-9a-f]{6,}$")


def stem(w: str) -> str:
    for suf in ("ing", "s"):
        if len(w) > len(suf) + 2 and w.endswith(suf):
            return w[: -len(suf)]
    return w


def tokenize(text: str) -> List[str]:
    return [stem(t) for t in re.findall(r"[a-z0-9]+", text.lower())]


def query_terms(prompt: str) -> List[str]:
    raw = re.findall(r"[a-z0-9]+", prompt.lower())
    terms = [stem(t) for t in raw if t not in STOPWORDS and (len(t) >= 2 or t.isdigit())]
    if not terms:
        terms = [stem(t) for t in raw]
    return list(dict.fromkeys(terms))


# ---------------------------------------------------------------- store access
def default_dir() -> str:
    env = os.environ.get("UVIAN_DIR")
    if env:
        return env
    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def format_path(uid: str) -> str:
    return f"$UVIAN_DIR/{uid[0]}/{uid[1]}/{uid[2:4]}/{uid}" if len(uid) >= 4 else f"$UVIAN_DIR/{uid}"


def iter_cells(root: str):
    """Yield (uuid, file path) for every <root>/<u0>/<u1>/<u2u3>/<uuid> cell."""
    for dirpath, dirs, files in os.walk(root):
        rel = os.path.relpath(dirpath, root).replace("\\", "/")
        if rel == ".":
            dirs[:] = [d for d in dirs if not d.startswith(".")]
            continue
        parts = rel.split("/")
        if len(parts) >= 3:
            dirs[:] = []
        if len(parts) != 3:
            continue
        d1, d2, d3 = parts
        for name in files:
            if len(name) >= 4 and name[0] == d1 and name[1] == d2 and name[2:4] == d3:
                yield name, os.path.join(dirpath, name)


def load_summer(path: str) -> Dict[str, dict]:
    """Parse summer.yaml (`uuid: {json}` per line). Later duplicates win."""
    out: Dict[str, dict] = {}
    if not os.path.isfile(path):
        return out
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line or line.startswith("#") or ": " not in line:
                continue
            uid, _, body = line.partition(": ")
            try:
                obj = json.loads(body)
            except ValueError:
                continue
            if isinstance(obj, dict):
                out[uid.strip()] = obj
    return out


def read_cell(path: str) -> str:
    try:
        with open(path, "rb") as f:
            raw = f.read(MAX_CONTENT_BYTES)
    except OSError:
        return ""
    if b"\x00" in raw[:2048]:
        return ""
    text = raw.decode("utf-8", errors="ignore")
    head = text[:2048]
    if len(head) > 200 and not re.search(r"\s", head):
        return ""  # opaque blob (base64 / gpg armour without newlines)
    return text


def first_line(text: str, width: int = 140) -> str:
    for line in text.splitlines():
        s = line.strip()
        if s and not s.startswith("#!"):
            return s if len(s) <= width else s[: width - 1] + "…"
    return ""


def summaries_of(entry: dict) -> List[str]:
    if "encrypted" in entry:
        return []
    return [v for k, v in entry.items() if isinstance(v, str) and v.strip()]


# ---------------------------------------------------------------- ranking
class Doc:
    __slots__ = ("uid", "path", "entry", "content", "tf", "length", "terms")

    def __init__(self, uid: str, path: str, entry: dict, content: str):
        self.uid, self.path, self.entry, self.content = uid, path, entry, content
        summ = Counter(tokenize(" ".join(summaries_of(entry))))
        cont = Counter(tokenize(content))
        self.tf: Dict[str, float] = {}
        for t, n in summ.items():
            self.tf[t] = self.tf.get(t, 0.0) + SUMMARY_WEIGHT * n
        for t, n in cont.items():
            self.tf[t] = self.tf.get(t, 0.0) + CONTENT_WEIGHT * n
        self.length = SUMMARY_WEIGHT * sum(summ.values()) + CONTENT_WEIGHT * sum(cont.values())


def rank(docs: List[Doc], prompt: str) -> List[Tuple[float, Doc]]:
    terms = query_terms(prompt)
    if not docs:
        return []
    n = len(docs)
    avg = sum(d.length for d in docs) / n or 1.0
    df = {t: sum(1 for d in docs if t in d.tf) for t in terms}
    phrase = " ".join(re.findall(r"[a-z0-9]+", prompt.lower()))
    hex_tokens = [t for t in re.findall(r"[0-9a-f-]+", prompt.lower()) if UUID_HEX.match(t.replace("-", ""))]

    scored = []
    for d in docs:
        score, matched = 0.0, 0
        for t in terms:
            tf = d.tf.get(t)
            if not tf:
                continue
            matched += 1
            idf = math.log(1 + (n - df[t] + 0.5) / (df[t] + 0.5))
            score += idf * tf * (K1 + 1) / (tf + K1 * (1 - B + B * d.length / avg))
        if terms and matched:
            score *= 0.5 + 0.5 * matched / len(terms)
            if len(terms) >= 2 and len(phrase) >= 6:
                hay = " ".join(re.findall(r"[a-z0-9]+", (d.content + " " + " ".join(summaries_of(d.entry))).lower()))
                if phrase in hay:
                    score += 2.0
        uid = d.uid.lower()
        for h in hex_tokens:
            if uid == h or uid.replace("-", "").startswith(h.replace("-", "")):
                score += 10.0
        if score > 0:
            scored.append((score, d))
    scored.sort(key=lambda x: x[0], reverse=True)
    return scored


def build_docs(root: str, summer: Dict[str, dict]) -> List[Doc]:
    docs = []
    for uid, path in iter_cells(root):
        entry = summer.get(uid, {})
        content = "" if "encrypted" in entry else read_cell(path)
        docs.append(Doc(uid, path, entry, content))
    return docs


def render(score: float, d: Doc) -> str:
    out: Dict[str, object] = {"score": round(score, 3), "path": format_path(d.uid)}
    if "encrypted" in d.entry:
        out["encrypted"] = d.entry["encrypted"]
    else:
        out.update({k: v for k, v in d.entry.items() if isinstance(v, str)})
        if not summaries_of(d.entry):
            out["hint"] = first_line(d.content) or "(empty)"
    return f"{d.uid}: {json.dumps(out, ensure_ascii=False)}"


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(description="Search Uvian cells with a free-text prompt; prints summer.yaml-style lines.")
    p.add_argument("prompt", nargs="*", help="search prompt (read from stdin when omitted)")
    p.add_argument("-n", "--top", type=int, default=10, help="max results (default 10, 0 = all)")
    p.add_argument("-d", "--dir", default=default_dir(), help="uvian root (default $UVIAN_DIR or the parent of .function)")
    p.add_argument("-y", "--yaml", default="summer.yaml", help="summary file, relative to --dir (default summer.yaml)")
    p.add_argument("-m", "--min-score", type=float, default=0.0, help="drop hits scoring at or below this (default 0)")
    args = p.parse_args(argv)

    prompt = " ".join(args.prompt).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        p.error("give a prompt as arguments or on stdin")

    root = os.path.abspath(os.path.expanduser(args.dir))
    if not os.path.isdir(root):
        sys.stderr.write(f"entry-search: uvian dir not found: {root}\n")
        return 1
    yaml_path = args.yaml if os.path.isabs(args.yaml) else os.path.join(root, args.yaml)
    hits = [h for h in rank(build_docs(root, load_summer(yaml_path)), prompt) if h[0] > args.min_score]
    if args.top > 0:
        hits = hits[: args.top]
    for score, d in hits:
        print(render(score, d))
    return 0


if __name__ == "__main__":
    sys.exit(main())
