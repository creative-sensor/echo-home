# Rust from the dist tarball, no rustup (artefacts: rust = x86_64-pc-windows-gnu, rustc = x86_64-pc-windows-gnullvm,
# which links with llvm-mingw's x86_64-w64-mingw32-clang). Both install into $LOCAL_BIN/rust: keep one of them.
# The tarball keeps every component in its own folder (rustc/, cargo/, rust-std-<target>/, ...) for its install.sh
# to merge. rustc looks for its standard library under its own prefix (lib/rustlib/<target>/lib): used in place, the
# components fail with "can't find crate for `core`". Merged here into one prefix: PATH gets $LOCAL_BIN/rust/bin.
rm -rf $LOCAL_BIN/rust $LOCAL_BIN/rust-dist
mkdir -p $LOCAL_BIN/rust $LOCAL_BIN/rust-dist
tar xf $ARTIFACT_DIR/$name-$ARTIFACT_VERSION.$ARTIFACT_SUFFIX -C $LOCAL_BIN/rust-dist
RUST_DIST=$(ls -d $LOCAL_BIN/rust-dist/rust-${ARTIFACT_VERSION}-* | head -1)
for component in $(cat $RUST_DIST/components); do
    test "$component" = rust-docs && continue   # the offline book and API docs: big, not needed to build
    cp -r $RUST_DIST/$component/. $LOCAL_BIN/rust/
done
rm -f $LOCAL_BIN/rust/manifest.in
rm -rf $LOCAL_BIN/rust-dist
$LOCAL_BIN/rust/bin/rustc -vV
