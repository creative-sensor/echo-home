let g:memphia_python = 'python'
let g:memphia_no_autostart = v:true


map mmph1 : silent source ~/echo-home/.vim/mimd/memphia/memphia.lua<CR>
map mmphg : exec 'Memphia --port '.LMSH_PORT.' --memgraph-uri bolt://127.0.0.1:7687 --llamark'<CR>
map mmphq : MemphiaQuit <CR>

"HELP:
"- Interrupt the LLM: Ctrl-X instead of Esc, so Esc still leaves insert mode.
"- Quit: :MemphiaQuit or Ctrl-Q.
"- Jump to the input line: i, a or Enter while in an output pane.
"- Intelligence Network: set up in vimpage_inet (inetj plugs Memphia in with its profile, inetr opens the room).
"  Inside Memphia: ===n help, ===nj/===nl join/leave by hand, ===ns <text> speaks. F8 toggles the IFACE pane.
"- g:memphia_python sets which Python to use (default python3). Calling require("memphia") from your config loads the commands without opening the UI.
